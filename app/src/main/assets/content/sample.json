    "descriptions": [
      { "male": "浓眉压眼，脸部轮廓颇为突兀。", "female": "阔额窄颌，五官相形悬殊。" },
      { "male": "眉眼粗重，轮廓略显参差。", "female": "眉眼偏疏，轮廓略显生硬。" },
      { "male": "相貌寻常，眉目平和。", "female": "相貌寻常，眉目平和。" },
      { "male": "五官端正，举止利落。", "female": "五官匀称，仪态端方。" },
      { "male": "眉眼俊朗，目光清亮。", "female": "眉目清秀，笑意明朗。" },
      { "male": "眉目俊逸，在人群中颇为惹眼。", "female": "眉目秀丽，举止娴雅。" },
      { "male": "神采卓然，眉宇间自有风流。", "female": "姿容明艳，一颦一笑皆见风姿。" }
    ]
  }
